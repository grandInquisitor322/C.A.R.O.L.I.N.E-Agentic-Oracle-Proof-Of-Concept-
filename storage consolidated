export class DatabaseStorage implements IStorage {
  private initialized = false;

  private async ensureInitialized() {
    if (this.initialized) return;
    try {
      const existingCoins = await db.select().from(coins);
      if (existingCoins.length === 0) {
        await db.insert(coins).values(
          initialCoins.map((coinData) => ({ ...coinData, createdAt: new Date(), updatedAt: new Date() }))
        );
      }
      this.initialized = true;
    } catch (error) {
      console.error('Failed to initialize storage:', error);
      throw error;
    }
  }

  // User methods
  async getUser(id: number): Promise<User | undefined> {
    await this.ensureInitialized();
    const [user] = await db.select().from(users).where(eq(users.id, id));
    return user;
  }

  async getUserByUsername(username: string): Promise<User | undefined> {
    await this.ensureInitialized();
    const [user] = await db.select().from(users).where(eq(users.username, username));
    return user;
  }

  async createUser(user: InsertUser): Promise<User> {
    await this.ensureInitialized();
    const [newUser] = await db.insert(users).values({ ...user, createdAt: new Date() }).returning();
    return newUser;
  }

  // Coin methods
  async getCoin(symbol: string): Promise<Coin | undefined> {
    await this.ensureInitialized();
    const [coin] = await db.select().from(coins).where(eq(coins.symbol, symbol.toUpperCase()));
    return coin;
  }

  async getAllCoins(): Promise<Coin[]> {
    await this.ensureInitialized();
    return await db.select().from(coins).orderBy(coins.id);
  }

  async upsertCoin(insertCoin: InsertCoin): Promise<Coin> {
    await this.ensureInitialized();
    const existing = await this.getCoin(insertCoin.symbol);
    if (existing) {
      const [updated] = await db
        .update(coins)
        .set({ ...insertCoin, updatedAt: new Date() })
        .where(eq(coins.symbol, insertCoin.symbol))
        .returning();
      return updated;
    } else {
      const [newCoin] = await db
        .insert(coins)
        .values({ ...insertCoin, createdAt: new Date(), updatedAt: new Date() })
        .returning();
      return newCoin;
    }
  }

  // Transaction methods
  async getTransactionsByCoin(coinSymbol: string, limit: number = 50): Promise<AppEnrichedTransaction[]> {
    await this.ensureInitialized();
    const [coin] = await db.select().from(coins).where(eq(coins.symbol, coinSymbol.toUpperCase()));
    if (!coin) return [];
    const txs = await db
      .select()
      .from(transactions)
      .where(eq(transactions.chainId, coin.chainId))
      .orderBy(desc(transactions.timestamp))
      .limit(limit);
    return txs.map((tx) => ({ ...tx, isConfirmed: (tx.confirmations ?? 0) >= 6 }));
  }

  async createTransaction(insertTransaction: InsertTransaction): Promise<AppEnrichedTransaction> {
    await this.ensureInitialized();
    const [transaction] = await db
      .insert(transactions)
      .values({
        ...insertTransaction,
        createdAt: new Date(),
        blockHeight: insertTransaction.blockHeight ?? 0,
        fromAddress: insertTransaction.fromAddress ?? '',
        toAddress: insertTransaction.toAddress ?? '',
        amount: BigInt(insertTransaction.amount ?? 0n),
        fee: BigInt(insertTransaction.fee ?? 0n),
        timestamp: insertTransaction.timestamp ?? new Date(),
        confirmations: insertTransaction.confirmations ?? 0,
        category: insertTransaction.category ?? 'transfer',
        status: insertTransaction.status ?? 'pending',
        chainId: insertTransaction.chainId ?? 1,
      })
      .returning();
    return { ...transaction, isConfirmed: (transaction.confirmations ?? 0) >= 6 };
  }

  // Block methods
  async getBlocksByCoin(coinSymbol: string, limit: number = 50): Promise<Block[]> {
    await this.ensureInitialized();
    const [coin] = await db.select().from(coins).where(eq(coins.symbol, coinSymbol.toUpperCase()));
    if (!coin) return [];
    return await db
      .select()
      .from(blocks)
      .where(eq(blocks.chainId, coin.chainId))
      .orderBy(desc(blocks.timestamp))
      .limit(limit);
  }

  async createBlock(insertBlock: InsertBlock): Promise<Block> {
    await this.ensureInitialized();
    const [block] = await db
      .insert(blocks)
      .values({
        ...insertBlock,
        createdAt: new Date(),
        timestamp: insertBlock.timestamp ?? new Date(),
        difficulty: insertBlock.difficulty ?? '0',
        nonce: insertBlock.nonce ?? '0',
        size: insertBlock.size ?? 0,
        previousHash: insertBlock.previousHash ?? '',
        txCount: insertBlock.txCount ?? 0,
        confirmations: insertBlock.confirmations ?? 1,
        chainId: insertBlock.chainId ?? 1,
      })
      .returning();
    return block;
  }

  async searchByHash(query: string): Promise<{
    type: 'transaction' | 'block';
    data: AppEnrichedTransaction | Block;
    coinSymbol: string;
  }[]> {
    await this.ensureInitialized();
    const results: { type: 'transaction' | 'block'; data: AppEnrichedTransaction | Block; coinSymbol: string }[] = [];

    const foundTransactions = await db.query.transactions.findMany({
      where: or(
        ilike(transactions.txId, `%${query}%`),
        ilike(transactions.fromAddress, `%${query}%`),
        ilike(transactions.toAddress, `%${query}%`)
      ),
      with: { coin: true },
      limit: 5,
      orderBy: [desc(transactions.timestamp)],
    });

    foundTransactions.forEach((tx) => {
      results.push({
        type: 'transaction',
        data: { ...tx, isConfirmed: (tx.confirmations ?? 0) >= 6 },
        coinSymbol: tx.coin?.symbol ?? 'UNKNOWN',
      });
    });

    const foundBlocks = await db.query.blocks.findMany({
      where: ilike(blocks.hash, `%${query}%`),
      with: { coin: true },
      limit: 5,
      orderBy: [desc(blocks.timestamp)],
    });

    foundBlocks.forEach((block) => {
      results.push({
        type: 'block',
        data: block,
        coinSymbol: block.coin?.symbol ?? 'UNKNOWN',
      });
    });

    return results.slice(0, 10);
  }
}

// ─── StorageAdapter (chain-level UTXO & raw transaction storage) ──────────────

export class StorageAdapter {
  private db: any | null = null;
  private client: any | null = null;
  private initialized = false;
  private dataDir?: string;

  constructor(dataDir?: string) {
    this.dataDir = dataDir;
  }

  private async initDB(): Promise<void> {
    const isTest = process.env.NODE_ENV === 'test';

    if (isTest || this.dataDir) {
      const dbPath = isTest ? undefined : this.dataDir;
      this.client = new PGlite(dbPath);
      this.db = pgliteDrizzle(this.client);
    } else {
      const { drizzle } = await import('drizzle-orm/node-postgres');
      const { Pool } = await import('pg');
      const pool = new Pool({
        connectionString: process.env.DATABASE_URL || 'postgres://user:pass@localhost:5432/dbname',
      });
      this.client = pool;
      this.db = drizzle(this.client);
    }
  }

  async ensureInitialized(): Promise<void> {
    if (this.initialized) return;
    await this.initDB();

    await this.db.execute(sql`
      CREATE TABLE IF NOT EXISTS transactions (
        id SERIAL PRIMARY KEY,
        tx_id TEXT UNIQUE NOT NULL,
        chain_id INTEGER NOT NULL,
        amount BIGINT NOT NULL DEFAULT 0,
        fee BIGINT NOT NULL DEFAULT 0,
        category TEXT,
        status TEXT NOT NULL DEFAULT 'pending',
        from_address TEXT,
        to_address TEXT,
        block_height INTEGER DEFAULT 0,
        confirmations BIGINT NOT NULL DEFAULT 0,
        timestamp TIMESTAMP,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      )
    `);

    await this.db.execute(sql`
      CREATE TABLE IF NOT EXISTS utxos (
        id SERIAL PRIMARY KEY,
        txid TEXT NOT NULL,
        vout INTEGER NOT NULL,
        chain_id INTEGER NOT NULL,
        value BIGINT NOT NULL,
        script_pubkey TEXT NOT NULL,
        address TEXT NOT NULL,
        confirmations BIGINT NOT NULL DEFAULT 0,
        block_height INTEGER DEFAULT 0,
        spent BOOLEAN DEFAULT FALSE,
        spent_txid TEXT,
        spent_height INTEGER,
        timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(txid, vout)
      )
    `);

    this.initialized = true;
  }

  async close(): Promise<void> {
    if (this.client) {
      try {
        if (typeof this.client.close === 'function') {
          await this.client.close();
        } else if (typeof this.client.end === 'function') {
          await this.client.end();
        }
      } catch (err) {
        console.warn('Close warning:', err);
      }
      this.client = null;
    }
    this.db = null;
    this.initialized = false;
  }

  async saveTransaction(tx: ChainEnrichedTransaction): Promise<void> {
    await this.ensureInitialized();

    const txId = tx.hash || tx.txId || 'unknown';
    const chainId = Number(tx.chainId);
    const amount = BigInt(tx.amount || 0);
    const fee = BigInt(tx.fee || 0);
    const category = tx.category || 'transfer';
    const status = tx.status || 'pending';
    const fromAddress = tx.from || null;
    const toAddress = tx.to || tx.toAddress || null;
    const blockHeight = tx.blockHeight || 0;
    const confirmations = BigInt(tx.confirmations || 0);
    const timestamp = tx.timestamp || new Date();

    await this.db.execute(sql`
      INSERT INTO transactions (
        tx_id, chain_id, amount, fee, category, status,
        from_address, to_address, block_height, confirmations, timestamp
      )
      VALUES (
        ${txId}, ${chainId}, ${amount}, ${fee}, ${category}, ${status},
        ${fromAddress}, ${toAddress}, ${blockHeight}, ${confirmations}, ${timestamp}
      )
      ON CONFLICT (tx_id) DO UPDATE SET
        confirmations = EXCLUDED.confirmations,
        block_height = EXCLUDED.block_height,
        status = EXCLUDED.status
    `);
  }

  async getTransactionsByAddress(
    chainId: ChainId,
    address: string
  ): Promise<ChainEnrichedTransaction[]> {
    await this.ensureInitialized();

    const results = await this.db.execute(sql`
      SELECT * FROM transactions
      WHERE chain_id = ${Number(chainId)}
        AND (from_address = ${address} OR to_address = ${address})
      ORDER BY timestamp DESC
    `);

    const rows = results.rows as TransactionRow[];
    return rows.map((row) => {
      const txTimestamp = row.timestamp ? new Date(row.timestamp) : new Date();
      const time = isNaN(txTimestamp.getTime()) ? 0 : txTimestamp.getTime() / 1000;
      return {
        hash: row.tx_id,
        txId: row.tx_id,
        chainId: row.chain_id as unknown as ChainId,
        time,
        amount: row.amount.toString(),
        fee: row.fee?.toString() || '0',
        category: (row.category as TransactionCategory) || undefined,
        status: row.status || undefined,
        from: row.from_address || undefined,
        to: row.to_address || undefined,
        toAddress: row.to_address || undefined,
        blockHeight: row.block_height || undefined,
        confirmations: Number(row.confirmations ?? 0),
        timestamp: txTimestamp,
      } as ChainEnrichedTransaction;
    });
  }

  async getTransactionCount(chainId: ChainId, address: string): Promise<number> {
    await this.ensureInitialized();
    const result = await this.db.execute(sql`
      SELECT COUNT(*) as count FROM transactions
      WHERE chain_id = ${Number(chainId)}
        AND (from_address = ${address} OR to_address = ${address})
    `);
    return Number(result.rows[0]?.count || 0);
  }

  async saveUTXO(utxo: BaseUtxo): Promise<void> {
    await this.ensureInitialized();

    const txid = utxo.txid;
    const vout = utxo.vout || 0;
    const chainId = Number(utxo.chainId);
    const value = BigInt(utxo.value || 0);
    const scriptPubKey = utxo.scriptPubKey || '';
    const address = utxo.address || '';
    const confirmations = BigInt(utxo.confirmations || 0);
    const blockHeight = utxo.blockHeight || 0;
    const spent = utxo.spent || false;
    const spentTxId = utxo.spentTxId || null;
    const spentHeight = utxo.spentHeight || null;
    const timestamp = utxo.timestamp || new Date();

    await this.db.execute(sql`
      INSERT INTO utxos (
        txid, vout, chain_id, value, script_pubkey, address,
        confirmations, block_height, spent, spent_txid, spent_height, timestamp
      )
      VALUES (
        ${txid}, ${vout}, ${chainId}, ${value}, ${scriptPubKey}, ${address},
        ${confirmations}, ${blockHeight}, ${spent}, ${spentTxId}, ${spentHeight}, ${timestamp}
      )
      ON CONFLICT (txid, vout) DO UPDATE SET
        confirmations = EXCLUDED.confirmations,
        block_height = EXCLUDED.block_height,
        spent = EXCLUDED.spent,
        spent_txid = EXCLUDED.spent_txid,
        spent_height = EXCLUDED.spent_height
    `);
  }

  async getUTXOs(
    chainId: ChainId,
    address: string,
    minConfirmations: number = 0
  ): Promise<BaseUtxo[]> {
    await this.ensureInitialized();

    const results = await this.db.execute(sql`
      SELECT * FROM utxos
      WHERE chain_id = ${Number(chainId)}
        AND address = ${address}
        AND spent = FALSE
        AND confirmations >= ${minConfirmations}
      ORDER BY confirmations DESC, value DESC
    `);

    return (results.rows as any[]).map((row) => ({
      chainId: row.chain_id as unknown as ChainId,
      addressType: 'p2pkh' as any,
      scriptType: 'standard' as any,
      config: {} as any,
      txid: row.txid,
      vout: row.vout,
      value: row.value.toString(),
      scriptPubKey: row.script_pubkey,
      address: row.address,
      confirmations: Number(row.confirmations),
      blockHeight: row.block_height,
      timestamp: row.timestamp,
      spent: row.spent,
    } as BaseUtxo));
  }

  async markUTXOAsSpent(
    txid: string,
    vout: number,
    spentTxId: string,
    spentHeight: number
  ): Promise<void> {
    await this.ensureInitialized();
    await this.db.execute(sql`
      UPDATE utxos
      SET spent = TRUE, spent_txid = ${spentTxId}, spent_height = ${spentHeight}
      WHERE txid = ${txid} AND vout = ${vout}
    `);
  }

  async getAddressBalance(chainId: ChainId, address: string): Promise<string> {
    await this.ensureInitialized();
    const result = await this.db.execute(sql`
      SELECT COALESCE(SUM(value), 0) as balance FROM utxos
      WHERE chain_id = ${Number(chainId)}
        AND address = ${address}
        AND spent = FALSE
    `);
    const balance = result.rows[0]?.balance || 0n;
    return balance.toString();
  }

  async pruneOldTransactions(
    chainId: ChainId,
    minConfirmations: number,
    olderThanDays?: number
  ): Promise<number> {
    await this.ensureInitialized();

    let query = sql`
      DELETE FROM transactions
      WHERE chain_id = ${Number(chainId)}
        AND confirmations < ${minConfirmations}
    `;

    if (olderThanDays) {
      const cutoffDate = new Date(Date.now() - olderThanDays * 86400000);
      query = sql`
        DELETE FROM transactions
        WHERE chain_id = ${Number(chainId)}
          AND confirmations < ${minConfirmations}
          AND timestamp < ${cutoffDate}
      `;
    }

    const result = await this.db.execute(query);
    return result.rowCount || 0;
  }

  async pruneSpentUTXOs(chainId: ChainId, olderThanDays: number = 30): Promise<number> {
    await this.ensureInitialized();
    const cutoffDate = new Date(Date.now() - olderThanDays * 86400000);
    const result = await this.db.execute(sql`
      DELETE FROM utxos
      WHERE chain_id = ${Number(chainId)}
        AND spent = TRUE
        AND timestamp < ${cutoffDate}
    `);
    return result.rowCount || 0;
  }

  async getStatistics(chainId: ChainId): Promise<{
    totalTransactions: number;
    totalUTXOs: number;
    spentUTXOs: number;
    totalValue: string;
  }> {
    await this.ensureInitialized();

    const txCount = await this.db.execute(sql`
      SELECT COUNT(*) as count FROM transactions WHERE chain_id = ${Number(chainId)}
    `);

    const utxoStats = await this.db.execute(sql`
      SELECT
        COUNT(*) as total,
        SUM(CASE WHEN spent = TRUE THEN 1 ELSE 0 END) as spent,
        COALESCE(SUM(CASE WHEN spent = FALSE THEN value ELSE 0 END), 0) as value
      FROM utxos
      WHERE chain_id = ${Number(chainId)}
    `);

    const stats = utxoStats.rows[0] || {};
    return {
      totalTransactions: Number(txCount.rows[0]?.count || 0),
      totalUTXOs: Number(stats.total || 0),
      spentUTXOs: Number(stats.spent || 0),
      totalValue: (stats.value || 0n).toString(),
    };
  }
}

