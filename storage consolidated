// ─── Types ────────────────────────────────────────────────────────────────────

/** Enriched transaction used by the app-level IStorage interface */
type AppEnrichedTransaction = Transaction & { isConfirmed: boolean };

/** Raw SQL row returned from the database (snake_case) */
export type TransactionRow = {
  id: number;
  tx_id: string;
  chain_id: number;
  amount: bigint;
  fee: bigint | null;
  category: string | null;
  status: string;
  from_address: string | null;
  to_address: string | null;
  block_height: number | null;
  confirmations: bigint;
  timestamp: Date | null;
  created_at: Date | null;
};

// ─── IStorage interface ───────────────────────────────────────────────────────

export interface IStorage {
  // User methods
  getUser(id: number): Promise<User | undefined>;
  getUserByUsername(username: string): Promise<User | undefined>;
  createUser(user: InsertUser): Promise<User>;

  // Coin methods
  getCoin(symbol: string): Promise<Coin | undefined>;
  getAllCoins(): Promise<Coin[]>;
  upsertCoin(coin: InsertCoin): Promise<Coin>;

  // Transaction methods
  getTransactionsByCoin(coinSymbol: string, limit?: number): Promise<AppEnrichedTransaction[]>;
  createTransaction(transaction: InsertTransaction): Promise<AppEnrichedTransaction>;

  // Block methods
  getBlocksByCoin(coinSymbol: string, limit?: number): Promise<Block[]>;
  createBlock(block: InsertBlock): Promise<Block>;

  // Search methods
  searchByHash(query: string): Promise<{
    type: 'transaction' | 'block';
    data: AppEnrichedTransaction | Block;
    coinSymbol: string;
  }[]>;
}

