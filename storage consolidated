  async searchByHash(query: string): Promise<{
    type: 'transaction' | 'block';
    data: AppEnrichedTransaction | Block;
    coinSymbol: string;
  }[]> {
    this.ensureInitialized();
    const results: { type: 'transaction' | 'block'; data: AppEnrichedTransaction | Block; coinSymbol: string }[] = [];
    const q = query.toLowerCase();

    for (const transaction of this.transactions.values()) {
      if (
        transaction.txId.toLowerCase().includes(q) ||
        (transaction.fromAddress?.toLowerCase().includes(q) ?? false) ||
        (transaction.toAddress?.toLowerCase().includes(q) ?? false)
      ) {
        const coin = this.getCoinByChainId(transaction.chainId);
        results.push({ type: 'transaction', data: transaction, coinSymbol: coin?.symbol ?? 'UNKNOWN' });
      }
    }

    for (const block of this.blocks.values()) {
      if (block.hash.toLowerCase().includes(q)) {
        const coin = this.getCoinByChainId(block.chainId);
        results.push({ type: 'block', data: block, coinSymbol: coin?.symbol ?? 'UNKNOWN' });
      }
    }

    return results.slice(0, 10);
  }

  private getCoinByChainId(chainId: number): Coin | undefined {
    return Array.from(this.coins.values()).find((c) => c.chainId === chainId);
  }
}

